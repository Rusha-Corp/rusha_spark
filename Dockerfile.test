ARG SPARK_BASE_IMAGE=rusha-spark-4.1-base:latest
FROM ${SPARK_BASE_IMAGE}

COPY scripts/ci/check-runtime-jars.py /usr/local/bin/check-runtime-jars.py
COPY scripts/ci/smoke-test.sh /usr/local/bin/smoke-test.sh

RUN chmod 0555 /usr/local/bin/check-runtime-jars.py /usr/local/bin/smoke-test.sh

ENTRYPOINT ["/usr/local/bin/smoke-test.sh"]
